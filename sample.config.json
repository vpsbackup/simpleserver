{
  "behind_nginx": true,
  "port": 18080,
  "domain": "demo.example.com",
  "tcping": false,
  "tcping6": false,
  "msg": true,
  "tracer": false,
  "enable_view": true,
  "v4_fn": "./data/fake-v4.txt",
  "v6_fn": "./data/fake-v6.txt",
  "max_single_file_mb": 50,
  "max_total_file_gb": 2,
  "udp_port": 0,
  "tcp_port": 0,
  "use_quic": false,
  "quic_only": false,
  "quic_addr": ":8443",
  "quic_cert_path": "/etc/ssl/certs/demo.example.com.pem",
  "quic_key_path": "/etc/ssl/private/demo.example.com.key",
  "agent_upstream_hosts": [
    "llmapi.qiniu.com",
    "llmapi.qiniu.io",
    "heilovehei.com",
    "api.fake-llm.example"
  ],
  "mongo_uri": "mongodb://demo_user:demo_pass_change_me@127.0.0.1:27017/?authSource=admin",
  "mongo_db": "simpleserver_demo",
  "mongo_coll": "messages",
  "upload_dir": "/var/tmp/simpleserver-demo/dl",
  "static_dir": "./public",
  "auth_password": "replace-me-login-password",
  "cookie_pass": "replace-me-different-mac-secret",
  "auth_expire_s": 604800
}
